vars: {d2-config: {layout-engine: dagre; theme-id: 0}}
direction: down
train: "train_task3.csv\n585 rows · 47 features + target" {shape: stored_data}
validation: "validation_task3.csv\n196 rows · supplied validation split" {shape: stored_data}
test: "final_test_task3.csv\n500 rows · supplied final test" {shape: stored_data}
experiments: "Fit on training only\nEight baselines · random-forest feature selection"
tuning: "Compact GridSearchCV\nFive stratified training folds\nRefit feature selection inside each fold"
choose: "Compare all stages on validation\nWeighted F1 → accuracy → absolute F1 gap"
refit: "Refit the selected full pipeline\nTraining + validation · 781 rows"
evaluation: "Evaluate the fixed model on final test\nAccuracy · weighted F1 · classification errors"
results: "Results in data_science.ipynb\nDecisions in the CRISP-DM overview"
artifact: "model.pkl\nFitted pipeline · schema · three prepared examples"
app: "app.py · local Gradio extension\nSelect example · optional edits · predict"
train -> experiments
train -> tuning
experiments -> choose
tuning -> choose
validation -> choose: "Compare; no fitting"
choose -> refit
train -> refit
validation -> refit: "After selection"
refit -> evaluation
test -> evaluation: "No selection based on test scores"
evaluation -> results
refit -> artifact
test -> artifact: "Three feature rows; no targets"
artifact -> app: "Load; no retraining"
note: "Prepared exports: earlier preprocessing\nand person-level independence cannot be verified" {shape: text}
train -> note {style.stroke-dash: 4}

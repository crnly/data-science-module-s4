vars: {d2-config: {layout-engine: dagre; theme-id: 101; sketch: true}}
direction: down
train: "train_task3.csv\n585 rows · 47 features + target" {shape: stored_data}
validation: "validation_task3.csv\n196 rows · supplied validation split" {shape: stored_data}
test: "final_test_task3.csv\n500 rows · supplied final test" {shape: stored_data}
experiments: "Fit on training only\n8 baselines + 8 selected-feature variants"
folds: "Internal CV within the 585 training rows\nFive stratified group folds\nKeep identical observations together"
tuning: "Compact GridSearchCV\nRefit feature selection inside each fold\nChoose parameters by CV weighted F1"
choose: "Compare all stages on validation\nWeighted F1 → accuracy → absolute F1 gap"
refit: "Refit the selected full pipeline\nTraining + validation · 781 rows"
evaluation: "Evaluate the fixed model on final test\nAccuracy · weighted F1 · classification errors"
results: "Results in data_science.ipynb\nDecisions in the CRISP-DM overview"
artifact: "results.json\n24 comparisons · diagnostics · evaluation summary"
app: "app.py · local Gradio explorer\nOne model selector · stage comparison · explanations"
train -> experiments
train -> folds -> tuning
experiments -> choose
tuning -> choose
validation -> choose: "Compare; no fitting"
choose -> refit
train -> refit
validation -> refit: "After selection"
refit -> evaluation
test -> evaluation: "No selection based on test scores"
evaluation -> results
choose -> artifact: "All recorded training / validation comparisons"
evaluation -> artifact: "Selected model assessment"
artifact -> app: "Read results; no fitting or inference"
note: "Prepared Task-3 inputs: inherited preprocessing limits\nPerson-level independence remains unverified" {shape: text}
train -> note {style.stroke-dash: 4}
